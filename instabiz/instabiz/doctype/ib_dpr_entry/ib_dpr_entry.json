   "read_only": 1,
   "precision": "1",
   "depends_on": "eval:['Slitting','Cutting'].includes(doc.stage)"
  },
  {
   "fieldname": "total_sqm",
   "fieldtype": "Float",
   "label": "Total SQM",
   "read_only": 1,
   "precision": "3",
   "depends_on": "eval:['Slitting','Rewinding'].includes(doc.stage) || (doc.stage||'').indexOf('Coating')===0"
  },
  {
   "fieldname": "time_per_log",
   "fieldtype": "Float",
   "label": "Time / Log (min)",
   "read_only": 1,
   "precision": "2",
   "depends_on": "eval:['Rewinding','Cutting'].includes(doc.stage)"

   "default": "Today",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "shift",
   "fieldtype": "Select",
   "label": "Shift",
   "options": "Day\nNight",
   "default": "Day"
  },
  {
   "fieldname": "location",
   "fieldtype": "Select",
   "label": "Location",
   "options": "gujarat\nmaharashtra\nchennai",
   "default": "gujarat",
   "in_standard_filter": 1
  },
  {
   "fieldname": "col_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "stage",
   "fieldtype": "Select",
   "label": "Stage",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Coating WB\nCoating HM\nCoating PVC\nSlitting\nRewinding\nCutting\nSilicon\nPacking"
  },
  {
   "fieldname": "coating_substrate",
   "fieldtype": "Select",
   "label": "Coating Line / Film",
   "depends_on": "eval:(doc.stage||'').indexOf('Coating')===0",
   "mandatory_depends_on": "eval:(doc.stage||'').indexOf('Coating')===0",
   "options": "\nBOPP\nPVC\nAluminium Foil\nFoam\nKraft Paper\nHDPE\nDS Polyester",
   "description": "Sets the film density used in the consumption maths (BOPP/PVC/DS Poly 0.91, Foil 2.71, Foam 0.135, Kraft 1.0, HDPE 1.2)."
  },
  {
   "fieldname": "machine",
   "fieldtype": "Link",
   "label": "Machine",
   "options": "IB Machine",
   "in_list_view": 1,
   "in_standard_filter": 1

   "fieldtype": "Float",
   "label": "Liner / SQM (kg)",
   "read_only": 1,
   "precision": "6",
   "depends_on": "eval:doc.stage==='Coating HM'"
  },
  {
   "fieldname": "roll_weight",
   "fieldtype": "Float",
   "label": "Roll Weight (kg)",
   "read_only": 1,
   "precision": "3"
  },
  {
   "fieldname": "time_per_roll",
   "fieldtype": "Float",
   "label": "Time / Roll (min)",
   "read_only": 1,
   "precision": "2"

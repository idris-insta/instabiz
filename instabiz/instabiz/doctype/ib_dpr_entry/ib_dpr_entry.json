  {
   "fieldname": "qty_per_ctn",
   "fieldtype": "Float",
   "label": "QTY / CTN",
   "depends_on": "eval:['Slitting','Cutting'].includes(doc.stage)"
  },
  {
   "fieldname": "pcs_per_ctn",
   "fieldtype": "Float",
   "label": "PCS / CTN",
   "depends_on": "eval:['Packing','Silicon'].includes(doc.stage)",
   "default": "24"

{
 "doctype": "DocType",
 "name": "IB DPR Entry",
 "module": "Instabiz",
 "custom": 0,
 "autoname": "DPR-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "title_field": "item_code",
 "sort_field": "creation",
 "sort_order": "DESC",
 "track_changes": 1,
 "description": "Daily Production Report line — one machine run on one day, in the same columns and maths as the DPR sheet.",
 "engine": "InnoDB",
 "fields": [

 "font_size": 0,
 "html": "<style>\n  @page { size: 4in 6in; margin: 3mm; }\n  .print-format { margin: 0mm; }\n  body, table, th, td { font-family: Arial, sans-serif; }\n  body { font-size: 11px; color: #000; margin: 0; }\n  .ib-label { width: 100%; box-sizing: border-box; page-break-after: always; }\n  .ib-label:last-child { page-break-after: auto; }\n  .ib-lbl-tbl { width: 100%; border-collapse: collapse; }\n  .ib-lbl-tbl td, .ib-lbl-tbl th { border: 1px solid #000; padding: 4px 6px; vertical-align: middle; }\n  .ib-lbl-head { text-align: center; font-weight: bold; font-size: 13px; }\n  .ib-lbl-k { width: 32%; font-weight: bold; background: #f2f2f2; }\n  .ib-lbl-v { text-align: center; }\n  .ib-lbl-footer { text-align: center; font-size: 10px; text-decoration: underline; padding: 3px; }\n  .ib-lbl-codes { text-align: center; padding: 6px; }\n  .ib-lbl-codes img.ib-barcode { height: 0.55in; max-width: 90%; }\n  .ib-lbl-codes img.ib-qr { height: 0.9in; width: 0.9in; margin-top: 4px; }\n</style>\n\n{% set base_url = frappe.utils.get_url() %}\n{% for row in doc.items %}\n  {% set item = frappe.get_cached_doc(\"Item\", row.item_code) %}\n  {% set base_code = row.item_code.rsplit(\"-\", 1)[0] if \"-\" in row.item_code else row.item_code %}\n  {% set trace_id = doc.name ~ \"::\" ~ row.item_code ~ \"::\" ~ row.idx %}\n  {% set trace_url = base_url ~ \"/app/ib-trace?id=\" ~ (trace_id | urlencode) %}\n  {% set size_parts = [] %}\n  {% if item.width_mm %}{% set _ = size_parts.append((item.width_mm | int | string) + \"MM\") %}{% endif %}\n  {% if item.length_mtr %}{% set _ = size_parts.append((item.length_mtr | int | string) + \"M\") %}{% endif %}\n  {% for box_no in range(1, (row.no_of_boxes | int) + 1) %}\n    <div class=\"ib-label\">\n      <table class=\"ib-lbl-tbl\">\n        <tr><td colspan=\"2\" class=\"ib-lbl-head\">INSTABIZ SOLUTIONS INDIA PVT LTD (i-STIX)</td></tr>\n        <tr><td class=\"ib-lbl-k\">ITEM CODE</td><td class=\"ib-lbl-v\">{{ base_code }}</td></tr>\n        <tr><td class=\"ib-lbl-k\">ITEM MARK</td><td class=\"ib-lbl-v\">{{ row.item_code }}</td></tr>\n        <tr><td class=\"ib-lbl-k\">ITEM NAME</td><td class=\"ib-lbl-v\">{{ row.item_name }}</td></tr>\n        {% if size_parts %}\n        <tr><td class=\"ib-lbl-k\">ITEM SIZES</td><td class=\"ib-lbl-v\">{{ size_parts | join(\" X \") }}</td></tr>\n        {% endif %}\n        {% if item.color %}\n        <tr><td class=\"ib-lbl-k\">COLOR</td><td class=\"ib-lbl-v\">{{ item.color }}</td></tr>\n        {% endif %}\n        <tr><td class=\"ib-lbl-k\">QTY / CTN</td><td class=\"ib-lbl-v\">{{ row.qty_per_box }} {{ row.stock_uom }}</td></tr>\n        <tr><td class=\"ib-lbl-k\">ROLL NO</td><td class=\"ib-lbl-v\">{{ box_no }} / {{ row.no_of_boxes }}</td></tr>\n        <tr><td class=\"ib-lbl-k\">WEIGHT</td><td class=\"ib-lbl-v\">{% if item.custom_carton_weight_kg %}{{ item.custom_carton_weight_kg }} {% endif %}KGS</td></tr>\n        <tr><td class=\"ib-lbl-k\">BATCH NO</td><td class=\"ib-lbl-v\">{{ row.batch_no or \"\" }}</td></tr>\n        <tr><td class=\"ib-lbl-k\">CUSTOMER</td><td class=\"ib-lbl-v\"></td></tr>\n        <tr><td colspan=\"2\" class=\"ib-lbl-codes\">\n          <img class=\"ib-barcode\" src=\"{{ get_barcode_data_uri(row.barcode) }}\"><br>\n          <img class=\"ib-qr\" src=\"{{ get_qr_data_uri(trace_url) }}\">\n        </td></tr>\n        <tr><td colspan=\"2\" class=\"ib-lbl-footer\">INFO@INSTABIZSOLUTIONS.COM</td></tr>\n        <tr><td colspan=\"2\" class=\"ib-lbl-footer\">WWW.INSTABIZSOLUTIONS.COM</td></tr>\n      </table>\n    </div>\n  {% endfor %}\n{% endfor %}\n",
 "idx": 0,
 "line_breaks": 0,
